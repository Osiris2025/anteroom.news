# AI News Nexus - Environment Variables
# Copy to .env and fill in your values

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Auth secret - generate with: openssl rand -base64 48
AUTH_SECRET=your-generated-secret-here

# Database (defaults are in docker-compose.yml)
# NEXUS_DB_PASSWORD=changeme

# CRON_SECRET - shared secret for cron-triggered API endpoints (digest generation, etc.)
CRON_SECRET=your-cron-secret-here

# SMTP configuration for email digests (leave blank to disable sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=digests@nexus.osiris2025.com

# --- Deployment identity (optional) ---
# Public origin for this install. Everything user-facing — share links,
# bookmarklets, digest emails, OG tags, sitemap/robots, auth trusted origins —
# derives from this one value. Defaults to https://anteroom.news.
# NEXT_PUBLIC_SITE_URL is inlined into the browser bundle at BUILD time, so
# after changing it run: docker compose up -d --build frontend
# SITE_URL=https://your-domain.example

# Extra origins allowed to call the auth API (LAN / Tailscale / local dev),
# comma-separated. The public SITE_URL is always trusted.
# TRUSTED_ORIGINS=http://localhost:3001,http://192.168.1.50:3001
