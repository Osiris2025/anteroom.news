{
  "manifest_version": 3,
  "name": "AI News Nexus — Link Collector",
  "version": "1.0.0",
  "description": "Save any link to AI News Nexus as a draft. AI auto-detects the best magazine and checks suitability.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["https://nexus.osiris2025.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Nexus"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}