services:
  postgres:
    image: pgvector/pgvector:pg16
    container_name: nexus-db
    volumes:
      - nexus_pgdata:/var/lib/postgresql/data
    environment:
      HOSTNAME: "0.0.0.0"
      POSTGRES_DB: nexus
      POSTGRES_USER: nexus
      POSTGRES_PASSWORD: ${NEXUS_DB_PASSWORD:-changeme}
    ports:
      - "127.0.0.1:5433:5432"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U nexus"]
      interval: 10s

  engine:
    build:
      context: .
      dockerfile: engine/Dockerfile
    container_name: nexus-engine
    depends_on:
      postgres:
        condition: service_healthy
    env_file: .env
    volumes:
      - ./streams:/app/streams:ro
    restart: unless-stopped
    networks:
      - default
      - homelab_default

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: nexus-frontend
    ports:
      - "3001:3000"
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      HOSTNAME: "0.0.0.0"
      DATABASE_URL: postgresql://nexus:${NEXUS_DB_PASSWORD:-changeme}@postgres:5432/nexus
      AUTH_URL: ${AUTH_URL:-https://nexus.osiris2025.com}
      BETTER_AUTH_SECRET: ${AUTH_SECRET:-dev-only-change-me}
      # External ingress reaches the app on port 3000 inside the container (EXPOSE 3000)
    restart: unless-stopped
    networks:
      - default
      - homelab_default

networks:
  homelab_default:
    external: true

volumes:
  nexus_pgdata: